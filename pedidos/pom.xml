<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.github.lakes777.foil</groupId>
		<artifactId>foil</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>
	<artifactId>pedidos</artifactId>
	<name>pedidos</name>
	<description>Pedidos: guarda a máquina de estados e orquestra a saga</description>

	<dependencies>
		<dependency>
			<groupId>io.github.lakes777.foil</groupId>
			<artifactId>contratos</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.lakes777.foil</groupId>
			<artifactId>comum</artifactId>
		</dependency>

		<dependency>
			<groupId>io.github.lakes777.foil</groupId>
			<artifactId>comum</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-redpanda</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- O jar executável sai como -exec.jar; o jar comum fica para o teste de ponta a ponta -->
					<classifier>exec</classifier>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
